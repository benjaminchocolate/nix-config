result
result-*
.direnv/

# macOS
.DS_Store

# config/ is linked live, so programs write next to my files.
# Emacs state goes to XDG dirs (early-init.el); these are stragglers
config/emacs/*.elc
config/emacs/custom.el
config/emacs/elpa/
config/emacs/eln-cache/
config/emacs/etc/
config/emacs/var/
config/emacs/tree-sitter/
config/emacs/auto-save-list/
config/emacs/transient/
# Karabiner-Elements saves a dated copy on every GUI change
config/karabiner/automatic_backups/

# Generated by git-hooks.nix when the dev shell loads
/.pre-commit-config.yaml
